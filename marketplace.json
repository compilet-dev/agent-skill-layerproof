{
  "$schema": "https://claude.ai/schemas/skill-pack/v1",
  "name": "layerproof-agent-skills",
  "version": "1.1.0",
  "displayName": "Layerproof API Skills",
  "description": "Agent skills for the Layerproof public API (X-API-KEY): workspaces, projects, files, slide decks, slide editing, themes, tone presets, exports (incl. video), social campaigns, job polling.",
  "author": "Layerproof",
  "homepage": "https://github.com/compilet-dev/agent-skill-layerproof",
  "repository": "https://github.com/compilet-dev/agent-skill-layerproof",
  "license": "MIT",
  "env": [
    {
      "name": "LAYERPROOF_BASE_URL",
      "description": "Layerproof API base URL (e.g. https://api.layerproof.com)",
      "required": true
    },
    {
      "name": "LAYERPROOF_API_KEY",
      "description": "Layerproof API key — sent as X-API-KEY header on every request",
      "required": true
    }
  ],
  "skills": [
    {
      "name": "workspaces",
      "displayName": "Workspace Management",
      "description": "Create, list, get, update, delete workspaces; list deleted, restore, permanent delete, list workspace files. /api/v2/workspaces",
      "path": "skills/workspaces/SKILL.md",
      "endpoints": [
        "POST /api/v2/workspaces",
        "GET /api/v2/workspaces",
        "GET /api/v2/workspaces/deleted",
        "GET /api/v2/workspaces/{workspaceId}",
        "GET /api/v2/workspaces/{workspaceId}/files",
        "PUT /api/v2/workspaces/{workspaceId}",
        "DELETE /api/v2/workspaces/{workspaceId}",
        "POST /api/v2/workspaces/{workspaceId}/restore",
        "DELETE /api/v2/workspaces/{workspaceId}/permanently"
      ]
    },
    {
      "name": "projects",
      "displayName": "Project Management",
      "description": "Projects: cursor list, public list, clone, vote, visibility, recent, deleted, restore, permanent delete. /api/v2/projects",
      "path": "skills/projects/SKILL.md",
      "endpoints": [
        "POST /api/v2/projects",
        "GET /api/v2/projects",
        "GET /api/v2/projects/public",
        "GET /api/v2/projects/list/recent",
        "GET /api/v2/projects/deleted",
        "GET /api/v2/projects/{projectId}",
        "PUT /api/v2/projects/{projectId}",
        "PUT /api/v2/projects/{projectId}/visibility",
        "DELETE /api/v2/projects/{projectId}",
        "POST /api/v2/projects/{projectId}/restore",
        "DELETE /api/v2/projects/{projectId}/permanently",
        "POST /api/v2/projects/{projectId}/vote",
        "DELETE /api/v2/projects/{projectId}/vote",
        "POST /api/v2/projects/{projectId}/clone"
      ]
    },
    {
      "name": "public-files",
      "displayName": "Public File Upload",
      "description": "Upload reference files (images, documents) for outline generation. Prepare → PUT → confirm. /api/v2/files",
      "path": "skills/public-files/SKILL.md",
      "endpoints": [
        "POST /api/v2/files/prepare",
        "POST /api/v2/files/confirm",
        "POST /api/v2/files/delete",
        "POST /api/v2/files/download-url"
      ]
    },
    {
      "name": "project-files",
      "displayName": "Project File Management",
      "description": "Project directories: prepare/update upload, AI files, subdirectories, resolve assets, preview URL, file CRUD. /api/v2/projects/{projectId}",
      "path": "skills/project-files/SKILL.md",
      "endpoints": [
        "POST /api/v2/projects/{projectId}/directories/{directoryId}/files/prepare",
        "POST /api/v2/projects/{projectId}/directories/{directoryId}/files/prepare-update",
        "POST /api/v2/projects/{projectId}/directories/{directoryId}/subdirectories",
        "POST /api/v2/projects/{projectId}/directories/{directoryId}/resolve-assets",
        "POST /api/v2/projects/{projectId}/directories/{directoryId}/resolve-paths-to-ids",
        "POST /api/v2/projects/{projectId}/directories/{directoryId}/files/{fileId}/preview-url",
        "POST /api/v2/projects/{projectId}/directories/{directoryId}/ai-files",
        "POST /api/v2/projects/{projectId}/ai-files/{aiFileId}/trigger",
        "POST /api/v2/projects/{projectId}/ai-files/{aiFileId}/cancel",
        "POST /api/v2/projects/{projectId}/files/{fileId}/confirm",
        "GET /api/v2/projects/{projectId}/files/{fileId}",
        "GET /api/v2/projects/{projectId}/files/{fileId}/download-url",
        "DELETE /api/v2/projects/{projectId}/files/{fileId}"
      ]
    },
    {
      "name": "slide-decks",
      "displayName": "Slide Deck Generation",
      "description": "Generate outlines, batch/single slide content, transcripts, images, themes, audio, import PPTX. /api/v2/projects/{projectId}/slide-deck/{slideDeckId}",
      "path": "skills/slide-decks/SKILL.md",
      "endpoints": [
        "POST /api/v2/projects/{projectId}/slide-deck/{slideDeckId}/outline/generate",
        "PUT /api/v2/projects/{projectId}/slide-deck/{slideDeckId}/outline",
        "GET /api/v2/projects/{projectId}/slide-deck/{slideDeckId}/",
        "POST /api/v2/projects/{projectId}/slide-deck/{slideDeckId}/slides/batch-generate",
        "POST /api/v2/projects/{projectId}/slide-deck/{slideDeckId}/slides/generate-content",
        "POST /api/v2/projects/{projectId}/slide-deck/{slideDeckId}/slides/generate-transcript",
        "POST /api/v2/projects/{projectId}/slide-deck/{slideDeckId}/slides/generate-image",
        "POST /api/v2/projects/{projectId}/slide-deck/{slideDeckId}/cancel",
        "POST /api/v2/projects/{projectId}/slide-deck/{slideDeckId}/theme/generate",
        "PATCH /api/v2/projects/{projectId}/slide-deck/{slideDeckId}/theme/visual-style-description",
        "PUT /api/v2/projects/{projectId}/slide-deck/{slideDeckId}/slides/{slideSectionId}/transcript",
        "POST /api/v2/projects/{projectId}/slide-deck/{slideDeckId}/slides/{slideSectionId}/duplicate",
        "POST /api/v2/projects/{projectId}/slide-deck/{slideDeckId}/slides/improve",
        "POST /api/v2/projects/{projectId}/slide-deck/{slideDeckId}/slides/generate-manual",
        "GET /api/v2/projects/{projectId}/slide-deck/{slideDeckId}/tone-settings",
        "PUT /api/v2/projects/{projectId}/slide-deck/{slideDeckId}/tone-settings",
        "PATCH /api/v2/projects/{projectId}/slide-deck/{slideDeckId}",
        "POST /api/v2/projects/{projectId}/slide-deck/{slideDeckId}/import/prepare-upload",
        "POST /api/v2/projects/{projectId}/slide-deck/{slideDeckId}/import",
        "POST /api/v2/projects/{projectId}/slide-deck/{slideDeckId}/slides/batch-generate-layout",
        "GET /api/v2/projects/{projectId}/slide-deck/{slideDeckId}/citations",
        "GET /api/v2/projects/{projectId}/slide-deck/{slideDeckId}/citations/slide/{slideIndex}",
        "GET /api/v2/projects/{projectId}/slide-deck/{slideDeckId}/citations/{citationId}"
      ]
    },
    {
      "name": "slides",
      "displayName": "Slide Editing",
      "description": "AI image editing, object removal, text extraction, accept edits, revert, save Konva canvas. /api/v2/projects/{projectId}/slides",
      "path": "skills/slides/SKILL.md",
      "endpoints": [
        "POST /api/v2/projects/{projectId}/slides/{slideId}/image-edit",
        "POST /api/v2/projects/{projectId}/slides/{slideId}/accept-image-edit",
        "POST /api/v2/projects/{projectId}/slides/{slideId}/revert",
        "POST /api/v2/projects/{projectId}/slides/{slideId}/object-removal",
        "POST /api/v2/projects/{projectId}/slides/{slideId}/extract-text",
        "PUT /api/v2/projects/{projectId}/slides/{slideId}/konva-nodes"
      ]
    },
    {
      "name": "themes",
      "displayName": "Theme Management",
      "description": "Themes: list, get, save, update, delete, generate, regenerate, apply, unapply, by-user-id. /api/v2/themes",
      "path": "skills/themes/SKILL.md",
      "endpoints": [
        "GET /api/v2/themes",
        "GET /api/v2/themes/by-user-id",
        "GET /api/v2/themes/{themeId}",
        "POST /api/v2/themes",
        "PUT /api/v2/themes/{themeId}",
        "DELETE /api/v2/themes/{themeId}",
        "POST /api/v2/themes/generate",
        "POST /api/v2/themes/{themeId}/regenerate",
        "POST /api/v2/themes/apply",
        "POST /api/v2/themes/unapply"
      ]
    },
    {
      "name": "tones",
      "displayName": "Tone Presets",
      "description": "Tone preset library: CRUD, duplicate, apply to slide deck, save-as-preset. /api/v2/tones",
      "path": "skills/tones/SKILL.md",
      "endpoints": [
        "GET /api/v2/tones",
        "POST /api/v2/tones",
        "GET /api/v2/tones/{toneId}",
        "PUT /api/v2/tones/{toneId}",
        "DELETE /api/v2/tones/{toneId}",
        "POST /api/v2/tones/{toneId}/apply",
        "POST /api/v2/tones/save-as-preset",
        "POST /api/v2/tones/{toneId}/duplicate"
      ]
    },
    {
      "name": "exports",
      "displayName": "Export Slides",
      "description": "Export PNG ZIP, PPTX, or video (async). Poll status, download URL, cancel. /api/v2/projects/{projectId}/exports",
      "path": "skills/exports/SKILL.md",
      "endpoints": [
        "POST /api/v2/projects/{projectId}/exports/png",
        "POST /api/v2/projects/{projectId}/exports/pptx",
        "POST /api/v2/projects/{projectId}/exports/video",
        "GET /api/v2/projects/{projectId}/exports/{exportId}",
        "POST /api/v2/projects/{projectId}/exports/{exportId}/cancel"
      ]
    },
    {
      "name": "social-campaigns",
      "displayName": "Social Campaigns",
      "description": "Social campaigns: CRUD, generate, confirm outline, topics, variations, captions, theme, exports, citations/history. /api/v2/social-campaigns",
      "path": "skills/social-campaigns/SKILL.md",
      "endpoints": [
        "POST /api/v2/social-campaigns",
        "GET /api/v2/social-campaigns",
        "GET /api/v2/social-campaigns/{campaign_id}",
        "PUT /api/v2/social-campaigns/{campaign_id}",
        "PUT /api/v2/social-campaigns/{campaign_id}/settings",
        "POST /api/v2/social-campaigns/{campaign_id}/generate",
        "POST /api/v2/social-campaigns/{campaign_id}/confirm-outline",
        "POST /api/v2/social-campaigns/{campaign_id}/generate-theme",
        "DELETE /api/v2/social-campaigns/{campaign_id}",
        "POST /api/v2/social-campaigns/{campaign_id}/posts",
        "PUT /api/v2/social-campaigns/{campaign_id}/posts/{post_id}",
        "DELETE /api/v2/social-campaigns/{campaign_id}/posts/{post_id}",
        "PUT /api/v2/social-campaigns/{campaign_id}/reorder",
        "POST /api/v2/social-campaigns/{campaign_id}/posts/{post_id}/generate-variations",
        "POST /api/v2/social-campaigns/{campaign_id}/posts/{post_id}/generate-more-variations",
        "DELETE /api/v2/social-campaigns/{campaign_id}/posts/{post_id}/variations/{variation_id}",
        "POST /api/v2/social-campaigns/{campaign_id}/posts/{post_id}/variations/{variation_id}/retry",
        "POST /api/v2/social-campaigns/{campaign_id}/posts/{post_id}/variations/{variation_id}/generate-aspect-ratio",
        "POST /api/v2/social-campaigns/{campaign_id}/posts/{post_id}/variations/{variation_id}/edit-image",
        "POST /api/v2/social-campaigns/{campaign_id}/posts/{post_id}/variations/{variation_id}/accept-edit",
        "PUT /api/v2/social-campaigns/{campaign_id}/posts/{post_id}/caption",
        "POST /api/v2/social-campaigns/{campaign_id}/posts/{post_id}/generate-caption",
        "POST /api/v2/social-campaigns/{campaign_id}/exports/zip",
        "POST /api/v2/social-campaigns/{campaign_id}/posts/{post_id}/exports/zip",
        "GET /api/v2/social-campaigns/{campaign_id}/exports/{export_id}",
        "GET /api/v2/social-campaigns/{campaign_id}/citations",
        "GET /api/v2/social-campaigns/{campaign_id}/posts/{post_id}/citations",
        "GET /api/v2/social-campaigns/{campaign_id}/posts/{post_id}/platforms/{platform}/citations",
        "GET /api/v2/social-campaigns/{campaign_id}/posts/{post_id}/platforms/{platform}/history",
        "GET /api/v2/social-campaigns/{campaign_id}/posts/{post_id}/platforms/{platform}/edits"
      ]
    },
    {
      "name": "jobs",
      "displayName": "Job Monitoring",
      "description": "Poll any async job by activityId. Returns SCHEDULED/RUNNING/PENDING/DONE/CANCELED. /api/v2/jobs",
      "path": "skills/jobs/SKILL.md",
      "endpoints": [
        "GET /api/v2/jobs/{activityId}"
      ]
    }
  ],
  "installation": {
    "npxSkills": {
      "method": "npx",
      "command": "npx skills add compilet-dev/agent-skill-layerproof",
      "selectiveCommand": "npx skills add compilet-dev/agent-skill-layerproof --skill {skillName}",
      "globalCommand": "npx skills add compilet-dev/agent-skill-layerproof -g",
      "listCommand": "npx skills add compilet-dev/agent-skill-layerproof --list",
      "description": "Install via the Skills CLI (npx skills). Auto-detects Claude Code, Cursor, Codex, and OpenCode."
    },
    "claudeCode": {
      "method": "cli",
      "command": "claude skills install ./marketplace.json",
      "manual": {
        "description": "Add skill paths to your CLAUDE.md",
        "example": "## Agent Skills\n\nLoad the following skill files before performing any Layerproof API operations:\n\n- skills/workspaces/SKILL.md\n- skills/projects/SKILL.md\n- skills/public-files/SKILL.md\n- skills/project-files/SKILL.md\n- skills/slide-decks/SKILL.md\n- skills/slides/SKILL.md\n- skills/themes/SKILL.md\n- skills/tones/SKILL.md\n- skills/exports/SKILL.md\n- skills/social-campaigns/SKILL.md\n- skills/jobs/SKILL.md"
      }
    },
    "cursor": {
      "method": "npx",
      "command": "npx skills add compilet-dev/agent-skill-layerproof -a cursor"
    }
  },
  "keywords": [
    "layerproof",
    "slide-deck",
    "presentation",
    "ai-generation",
    "api",
    "curl",
    "agent-skills"
  ]
}
